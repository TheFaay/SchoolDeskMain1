{
  "name": "schooldesk-app--typescript",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:fees": "tsx --test lib/fees/invoice.test.ts",
    "test:scores": "node scripts/runServerTests.mjs lib/scores/validation.test.ts",
    "test:reports": "tsx --test lib/results/reportSheetPdf.test.ts",
    "test:results": "node scripts/runServerTests.mjs lib/results/getResults.test.ts",
    "test:attendance": "node scripts/runServerTests.mjs lib/attendance/date.test.ts lib/attendance/repository.test.ts",
    "test:ownership": "node scripts/runServerTests.mjs lib/auth/student-id.test.ts lib/auth/ownership.test.ts",
    "test:admissions": "tsx --test lib/admissions/paymentAmount.test.ts",
    "test:paystack": "node scripts/runServerTests.mjs lib/paystack.test.ts",
    "test:unit": "npm run test:fees && npm run test:scores && npm run test:reports && npm run test:results && npm run test:attendance && npm run test:ownership && npm run test:admissions && npm run test:paystack && npm run test:vitest",
    "test:vitest": "node scripts/runVitest.mjs",
    "smoke:routes": "node scripts/smokeRoutes.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx lib/db/seed.ts",
    "db:reset-dev": "tsx lib/db/seed.ts --wipe",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.15",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }

---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { applicationUrl } from "../lib/public-links";

const phone = import.meta.env.PUBLIC_SCHOOL_PHONE?.trim();
const email = import.meta.env.PUBLIC_SCHOOL_EMAIL?.trim();
const address = import.meta.env.PUBLIC_SCHOOL_ADDRESS?.trim() || "Benin City, Edo State, Nigeria";
const mapUrl = import.meta.env.PUBLIC_SCHOOL_MAP_URL?.trim();
const phoneLink = phone?.replace(/[^+\d]/g, "");
---

<BaseLayout
  title="Contact Us | Crown Heights Academy"
  description="Contact Crown Heights Academy in Benin City, Edo State, Nigeria."
>
  <PageHero
    eyebrow="Contact us"
    title="We are here to help"
    intro="Have a question about admissions, school life or your child's progress? Reach the Crown Heights Academy office."
  />

  <section class="section">
    <div class="container">
      <div class="contact-grid">
        {phone && (
          <article class="contact-card">
            <p class="eyebrow">Phone</p>
            <h2>Call the school office</h2>
            <a class="contact-value" href={`tel:${phoneLink}`}>{phone}</a>
            <a class="btn btn--primary" href={`tel:${phoneLink}`}>Call now</a>
          </article>
        )}
        {email && (
          <article class="contact-card">
            <p class="eyebrow">Email</p>
            <h2>Send us a message</h2>
            <a class="contact-value" href={`mailto:${email}`}>{email}</a>
            <a class="btn btn--primary" href={`mailto:${email}`}>Email us</a>
          </article>
        )}
        <article class="contact-card">
          <p class="eyebrow">Location</p>
          <h2>Find our school</h2>
          <span class="contact-value">{address}</span>
          {mapUrl && <a class="btn btn--primary" href={mapUrl} target="_blank" rel="noreferrer">Open map</a>}
        </article>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container contact-layout">
      <div>
        <p class="eyebrow">Contact the school</p>
        <h2>We welcome your enquiry</h2>
        <p class="lead">For admissions questions, you can submit an application online and the school will follow up using the contact details provided.</p>
        <p>Parents who already have a child at the school can use the Parent Login link to access the portal.</p>
      </div>
      <aside class="aside-panel">
        <h2>Admissions questions?</h2>
        <p>Applications are open for JSS 1 to SS 3 for the 2027/2028 session.</p>
        <a class="btn btn--primary" href={applicationUrl}>Apply online</a>
      </aside>
    </div>
  </section>
</BaseLayout>

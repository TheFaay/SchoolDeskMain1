---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";

const news = (await getCollection("news")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const entries = await Promise.all(news.map(async (entry) => ({ entry, ...(await render(entry)) })));
---

<BaseLayout
  title="News & Notices | Crown Heights Academy"
  description="Read admissions information and school news for Crown Heights Academy families in Benin City, Edo State."
>
  <PageHero
    eyebrow="News & notices"
    title="What's happening at Crown Heights"
    intro="Notices for parents and students, from admissions dates to everyday reminders."
  />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Latest updates</p>
        <h2>School notices</h2>
        <p class="lead">Important information for current and prospective families. Please check back regularly for new notices.</p>
      </div>

      <div class="notice-list">
        {entries.map(({ entry, Content }) => (
          <article class="notice-card" id={entry.id}>
            <div class="news-meta">
              <span class:list={["tag", entry.data.tag === "Admissions" && "tag--gold"]}>{entry.data.tag}</span>
              <time datetime={entry.data.pubDate.toISOString().slice(0, 10)}>{entry.data.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })}</time>
            </div>
            <h2>{entry.data.title}</h2>
            <p>{entry.data.summary}</p>
            <Content />
            <a class="text-link" href={entry.data.tag === "Admissions" ? "/admissions" : "/contact"}>
              {entry.data.tag === "Admissions" ? "View admissions information" : "Contact the school office"}
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

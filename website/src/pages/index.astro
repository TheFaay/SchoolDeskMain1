---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import { getCollection } from "astro:content";
import { applicationUrl } from "../lib/public-links";

const newsItems = (await getCollection("news"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Crown Heights Academy | Private Secondary School in Benin City"
  description="Discover Crown Heights Academy in Benin City, Edo State: a caring secondary school for JSS 1 to SS 3, with online admissions and the SchoolDesk family portal."
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="hero-badge">A school community in Benin City</p>
        <h1>
          Learn with purpose.
          <span class="hero-school">Grow with confidence.</span>
        </h1>
        <p class="hero-lead">
          At Crown Heights Academy, strong teaching and a caring community help
          young people find their strengths and take their next step — from
          JSS 1 to SS 3.
        </p>
        <div class="button-row">
          <a class="btn btn--gold" href={applicationUrl}>
            Start an application <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn--outline-light" href="/about">
            Get to know us
          </a>
        </div>
        <p class="hero-note">A private secondary school serving families in Benin City, Edo State.</p>
      </div>

      <div class="hero-visual" aria-label="Illustrative preview of the SchoolDesk family portal">
        <div class="portal-window">
          <div class="portal-topbar"><span class="portal-mark">CH</span><span>Crown Heights <small>ILLUSTRATIVE PORTAL PREVIEW</small></span><span class="portal-avatar">A</span></div>
          <div class="portal-welcome"><span>YOUR SCHOOL OVERVIEW</span><strong>Welcome to your family portal</strong><small>School updates, together in one place.</small></div>
          <div class="portal-student"><span class="portal-student-icon">01</span><span><strong>Student profile</strong><small>Attendance and school updates</small></span><b>Present</b></div>
          <div class="portal-student"><span class="portal-student-icon portal-student-icon--gold">02</span><span><strong>Student profile</strong><small>Results and fee information</small></span><b>View</b></div>
          <div class="portal-footer"><span>Updates for your children</span><span class="portal-live"><i></i> Role-based access</span></div>
        </div>
        <div class="hero-float"><span>One place for school updates</span><strong>Clear. Connected. Supportive.</strong></div>
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-label="School highlights">
    <div class="container trust-strip-inner">
      <span><strong>JSS 1 – SS 3</strong><small>Junior and senior secondary</small></span>
      <span><strong>Benin City</strong><small>Edo State, Nigeria</small></span>
      <span><strong>SchoolDesk portal</strong><small>Updates for families and staff</small></span>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Welcome to our school</p>
        <h2>A place where every child is known and encouraged</h2>
        <p class="lead">
          Crown Heights Academy is a private secondary school in Benin City,
          Edo State. We offer a complete secondary education for students in
          JSS 1 to SS 3.
        </p>
        <p>
          Our teachers combine strong classroom teaching with genuine care for
          each student. We want every child to feel safe, try their best and
          leave us ready for the next step in life. Parents are an important
          part of that journey, and we keep communication simple and clear.
        </p>
        <a class="text-link" href="/about">
          Read our story <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="quick-grid">
        <div class="quick-card">
          <strong>JSS 1 – SS 3</strong>
          <span>A complete six-year secondary education under one roof.</span>
        </div>
        <div class="quick-card">
          <strong>Caring teachers</strong>
          <span>Supportive teaching that helps every learner make progress.</span>
        </div>
        <div class="quick-card">
          <strong>Parent partnership</strong>
          <span>Clear updates and open communication with families.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section platform-section">
    <div class="container platform-grid">
      <div class="platform-visual" aria-hidden="true">
        <div class="platform-orbit platform-orbit--one"></div>
        <div class="platform-orbit platform-orbit--two"></div>
        <div class="platform-core"><span>CH</span><small>SchoolDesk</small></div>
        <span class="platform-node platform-node--family">Families</span>
        <span class="platform-node platform-node--staff">Teachers</span>
        <span class="platform-node platform-node--school">School office</span>
      </div>
      <div>
        <p class="eyebrow">A connected school experience</p>
        <h2>School life, easier to follow</h2>
        <p class="lead">Our SchoolDesk portal brings everyday school information into one secure place for families and staff.</p>
        <ul class="platform-points">
          <li><span>01</span><div><strong>Families stay informed</strong><small>Check attendance, published results, fee balances, notices and school events.</small></div></li>
          <li><span>02</span><div><strong>Teachers focus on learning</strong><small>Record class attendance and enter scores for assigned classes and subjects.</small></div></li>
          <li><span>03</span><div><strong>School teams work clearly</strong><small>Manage admissions, academic setup, fee records and school communications.</small></div></li>
        </ul>
        <a class="text-link" href="/platform">Explore the SchoolDesk platform <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">Why families choose us</p>
        <h2>Academic strength, wrapped in care</h2>
        <p class="lead">
          We believe a good school builds both a sharp mind and a strong
          character. These are the things we focus on every day.
        </p>
      </div>

      <div class="card-grid card-grid--3">
        <article class="feature-card">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5v-17Z"></path>
              <path d="M4 21.5A2.5 2.5 0 0 1 6.5 19H20"></path>
              <path d="M8 6h8M8 10h6"></path>
            </svg>
          </span>
          <h3>Strong foundations</h3>
          <p>
            Clear teaching, steady practice and regular feedback help students
            build real understanding in every subject.
          </p>
        </article>

        <article class="feature-card">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"></path>
            </svg>
          </span>
          <h3>Character that lasts</h3>
          <p>
            Respect, honesty and responsibility are part of school life, not
            just words on a wall.
          </p>
        </article>

        <article class="feature-card">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </span>
          <h3>A community that cares</h3>
          <p>
            Students, teachers and parents work together in a calm, friendly
            environment where everyone belongs.
          </p>
        </article>
      </div>
    </div>
  </section>

  <CtaBand />

  <section class="section">
    <div class="container">
      <div class="section-head-row">
        <div class="section-head">
          <p class="eyebrow">News &amp; notices</p>
          <h2>The latest from our school</h2>
        </div>
        <a class="text-link" href="/news">
          View all news <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="news-grid">
        {newsItems.map((item) => (
          <article class="news-card">
            <div class="news-meta">
              <span class:list={["tag", item.data.tag === "Admissions" && "tag--gold"]}>{item.data.tag}</span>
              <time datetime={item.data.pubDate.toISOString().slice(0, 10)}>{item.data.pubDate.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })}</time>
            </div>
            <h3>{item.data.title}</h3>
            <p>{item.data.summary}</p>
            <a class="text-link" href={`/news#${item.id}`}>Read notice <span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

# SchoolDesk local development environment
# Copy this file to .env, then replace the placeholders with your own values.
# Never commit .env or paste secret values into source control.

# Neon: pooled URL for app queries (host includes -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@NEON-POOLER-HOST/DBNAME?sslmode=require"

# Neon CLI writes the direct, unpooled URL under this name. Use for migrations only.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@NEON-DIRECT-HOST/DBNAME?sslmode=require"

# Better Auth. Generate a new random value for each environment, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Local origin now. Add the exact preview and production origins when deployed.
# This is intended for the Better Auth trustedOrigins setting in Stage 1.
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"

# Dev-only shared password for generated sample accounts (minimum 12 chars).
DEMO_PASSWORD=""

# Public app base URL used for absolute links and redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email delivery. NOTICE_TEST_TO is the test inbox used by current notice flows.
RESEND_API_KEY=""
# Set to a sender on a domain verified in Resend before enabling password reset.
RESEND_FROM=""
NOTICE_TEST_TO="you@example.com"

# Paystack. Test secret keys only (sk_test_); live keys are rejected by the app.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
ADMISSIONS_FEE_NAIRA="80000"

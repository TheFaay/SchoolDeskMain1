# Neon Postgres connection string. Copy this file to .env and fill in your own values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Better Auth (owned by the auth feature). Use a long random value.
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Feature 10: address that receives a notice sent from the admin page.
NOTICE_TEST_TO="you@example.com"
